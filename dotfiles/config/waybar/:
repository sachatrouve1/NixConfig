@import "styles/modules-center.css";
@import "styles/modules-left.css";
@import "styles/modules-right.css";
@import "theme_pywal.css";

* {
	font-family: "0xProto Nerd Font";
	font-weight: bold;
	font-size: 18px;
	color: @main-fg;
	min-height: 0;
	min-width: 0;
	margin: 0;
	padding: 0;
}

/* main outline */

window#waybar {
	background-color: @outline;
	background: transparent;
	margin-top: 6px;
}

/* main background */

window#waybar > box {
	padding: 0;
	margin: 0;
}

.modules-left,
.modules-center,
.modules-right {
	min-height: 0;
	padding: 0;
	margin: 0;
}

label, widget, button {
	min-height: 0;
	min-width: 0;
	margin: 0;
	padding: 0;
}

/* Tighten vertical background height above/below 12px text */
.modules-left label,
.modules-center label,
.modules-right label,
.modules-left widget,
.modules-center widget,
.modules-right widget,
#workspaces button {
	margin-top: -1px;
	margin-bottom: -1px;
}

/* hoverables */

#custom-theme_switcher:hover,
#idle_inhibitor:hover,
#clock.date:hover,
#network:hover,
#bluetooth:hover,
#custom-system_update:hover,
#mpris:hover,
#pulseaudio:hover,
#custom-distro:hover,
#custom-hyprsunset:hover {
	color: @hover-fg;
}

/* states */

.warning { color: @warning; }
.critical { color: @critical; }
.charging { color: @charging; }
.muted { color: @hover-fg; }

/* dividers */

#custom-left_div,
#custom-left_inv,
#custom-right_div,
#custom-right_inv {
	font-size: 14px;
	margin-top: -1px;
	margin-bottom: -1px;
}

/* buttons */

button {
	border-radius: 0px;
	padding: 0 5px;
	min-height: 0;
}
button:hover {
	background-color: @hover-bg;
	color: @hover-fg;
}

/* tooltips */

tooltip {
	border: 2px solid @main-br;
	border-radius: 10px;
	background-color: @main-bg;
}
tooltip label {
	margin: 2px 4px;
	font-weight: normal;
}
tooltip decoration {
	border: none;
	background-color: transparent;
}
