{
    "group/traygroup": {
        "orientation": "horizontal",
        "drawer": {},
        "modules": [
            "custom/traylauncher",
            "tray"
        ]
    },
    "custom/traylauncher": {
        "format": "󰍜",
        "tooltip": "System tray (click)",
        "min-length": 4,
        "max-length": 4
    },
    "tray": {
        "format": "{icon}",
        "icon-size": 16,
        "spacing": 10,
        "cursor": true
    }
}
