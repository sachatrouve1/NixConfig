{
    /*-------------
		includes
	-------------*/
    "include": [
        "~/.config/waybar/modules/clock.jsonc",
        "~/.config/waybar/modules/cpu.jsonc",
        "~/.config/waybar/modules/memory.jsonc",
        "~/.config/waybar/modules/battery.jsonc",
        "~/.config/waybar/modules/backlight.jsonc",
        "~/.config/waybar/modules/pulseaudio.jsonc",
        "~/.config/waybar/modules/mpris.jsonc",
        "~/.config/waybar/modules/idle_inhibitor.jsonc",
        "~/.config/waybar/modules/hyprland/workspaces.jsonc",
        "~/.config/waybar/modules/custom/distro.jsonc",
        "~/.config/waybar/modules/custom/dividers.jsonc",
        "~/.config/waybar/modules/custom/hyprsunset.jsonc",
        "~/.config/waybar/modules/custom/moonphase.jsonc",
        "~/.config/waybar/modules/custom/power_menu.jsonc",
        "~/.config/waybar/modules/custom/system_update.jsonc",
        "~/.config/waybar/modules/custom/temperature.jsonc",
        "~/.config/waybar/modules/extras/tray.jsonc",
        "~/.config/waybar/modules/network#bandwidth.jsonc"
    ],

    /*------------
		layout
	------------*/
    "modules-left": [
        // "group/theme_switcher",
        "group/traygroup",
        "custom/left_div#1",
        "hyprland/workspaces",
        "custom/right_div#1",
        "custom/moonphase",
        "network#bandwidth"
        // "tray"
        // "hyprland/window"
    ],
    "modules-center": [
        // "hyprland/windowcount",
        "custom/left_div#2",
        "custom/temperature",
        "custom/left_div#3",
        "memory",
        "custom/left_div#4",
        "cpu",
        "custom/left_inv#1",
        "custom/left_div#5",
        "custom/distro",
        "custom/right_div#2",
        "custom/right_inv#1",
        "clock#time",
        "custom/right_div#3",
        "clock#date",
        "custom/right_div#4",
        // "network",
        // "bluetooth",
        "idle_inhibitor",
        "custom/hyprsunset",
        "custom/system_update",
        "custom/right_div#5"
    ],
    "modules-right": [
        "mpris",
        "custom/left_div#6",
        "group/pulseaudio",
        "custom/left_div#7",
        "backlight",
        "custom/left_div#8",
        "battery",
        "custom/left_inv#2",
        "custom/power_menu"
    ],

    /*-------------
		options
	-------------*/
    "layer": "top",
    // "output":
    // "position":
    "height": 0,
    "width": 0,
    "margin": 0,
    "padding": 0,
    // "margin-top":
    // "margin-left":
    // "margin-bottom":
    // "margin-right":
    "spacing": 0,
    // "name":
    // "mode": "dock",
    // "start_hidden":
    // "modifier-reset":
    // "exclusive":
    // "fixed-center":
    // "passthrough":
    // "ipc":
    // "id":
    "reload_style_on_change": true
}
